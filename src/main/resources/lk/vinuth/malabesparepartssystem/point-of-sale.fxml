<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="lk.vinuth.malabesparepartssystem.controller.PointOfSaleController"
      spacing="16.0"
      prefWidth="520.0"
      prefHeight="430.0"
      style="-fx-background-color: #f4f6f8;">

    <padding>
        <Insets top="20.0"
                right="20.0"
                bottom="20.0"
                left="20.0"/>
    </padding>

    <!-- Main heading for the Point of Sale window. -->
    <Label text="Point of Sale"
           style="-fx-font-size: 24px;
                  -fx-font-weight: bold;
                  -fx-text-fill: #263238;"/>

    <!-- Short instruction for the user. -->
    <Label text="Select a spare part, enter the quantity and complete the sale."
           wrapText="true"
           style="-fx-text-fill: #546e7a;"/>

    <!-- Form controls arranged in rows and columns. -->
    <GridPane hgap="15.0"
              vgap="14.0">

        <!-- Spare part selector. -->
        <Label text="Spare Part"
               GridPane.columnIndex="0"
               GridPane.rowIndex="0"/>

        <ComboBox fx:id="partComboBox"
                  promptText="Select a spare part"
                  prefWidth="320.0"
                  onAction="#onPartSelected"
                  GridPane.columnIndex="1"
                  GridPane.rowIndex="0"/>

        <!-- Unit price display. -->
        <Label text="Unit Price"
               GridPane.columnIndex="0"
               GridPane.rowIndex="1"/>

        <Label fx:id="unitPriceLabel"
               text="Rs. 0.00"
               style="-fx-font-weight: bold;"
               GridPane.columnIndex="1"
               GridPane.rowIndex="1"/>

        <!-- Available stock display. -->
        <Label text="Available Stock"
               GridPane.columnIndex="0"
               GridPane.rowIndex="2"/>

        <Label fx:id="availableStockLabel"
               text="0"
               style="-fx-font-weight: bold;"
               GridPane.columnIndex="1"
               GridPane.rowIndex="2"/>

        <!-- Quantity input. -->
        <Label text="Sale Quantity"
               GridPane.columnIndex="0"
               GridPane.rowIndex="3"/>

        <TextField fx:id="saleQuantityField"
                   promptText="Enter quantity"
                   GridPane.columnIndex="1"
                   GridPane.rowIndex="3"/>

        <!-- Calculated total display. -->
        <Label text="Sale Total"
               GridPane.columnIndex="0"
               GridPane.rowIndex="4"/>

        <Label fx:id="saleTotalLabel"
               text="Rs. 0.00"
               style="-fx-font-size: 18px;
                      -fx-font-weight: bold;
                      -fx-text-fill: #2e7d32;"
               GridPane.columnIndex="1"
               GridPane.rowIndex="4"/>

    </GridPane>

    <!-- Action buttons. -->
    <HBox spacing="10.0">

        <Button text="Calculate Total"
                onAction="#onCalculateTotalButtonClick"
                style="-fx-background-color: #1565c0;
                       -fx-text-fill: white;"/>

        <Button text="Complete Sale"
                onAction="#onCompleteSaleButtonClick"
                style="-fx-background-color: #2e7d32;
                       -fx-text-fill: white;
                       -fx-font-weight: bold;"/>

        <Button text="Clear"
                onAction="#onClearButtonClick"/>

    </HBox>

    <!-- Validation and success message area. -->
    <Label fx:id="posStatusLabel"
           text=""
           wrapText="true"
           style="-fx-text-fill: #c62828;
                  -fx-font-weight: bold;"/>

</VBox>