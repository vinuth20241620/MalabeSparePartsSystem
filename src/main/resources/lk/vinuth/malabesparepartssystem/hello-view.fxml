<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="lk.vinuth.malabesparepartssystem.HelloController"
            prefWidth="1100.0"
            prefHeight="700.0"
            style="-fx-background-color: #f4f6f8;">

    <!-- Top section containing the application title and navigation buttons. -->
    <top>
        <VBox spacing="12.0"
              style="-fx-background-color: #263238;">

            <padding>
                <Insets top="18.0"
                        right="20.0"
                        bottom="18.0"
                        left="20.0"/>
            </padding>

            <!-- Main application heading. -->
            <Label text="Malabe Spare Parts System"
                   style="-fx-text-fill: white;
                          -fx-font-size: 26px;
                          -fx-font-weight: bold;"/>

            <!-- Navigation buttons for the main coursework features. -->
            <HBox spacing="10.0">

                <Button text="Inventory"
                        style="-fx-background-color: #00897b;
                               -fx-text-fill: white;
                               -fx-font-weight: bold;"/>

                <Button text="Dealers"/>

                <Button text="Low Stock"/>

                <Button text="Point of Sale"/>

            </HBox>
        </VBox>
    </top>

    <!-- Centre section containing the inventory table and controls. -->
    <center>
        <VBox spacing="15.0">

            <padding>
                <Insets top="20.0"
                        right="20.0"
                        bottom="20.0"
                        left="20.0"/>
            </padding>

            <!-- Section heading. -->
            <Label text="Inventory Management"
                   style="-fx-font-size: 21px;
                          -fx-font-weight: bold;"/>

            <!-- Search area. -->
            <HBox spacing="10.0">

                <TextField fx:id="searchField"
                           promptText="Search by code, name, brand or category"
                           HBox.hgrow="ALWAYS"/>

                <Button text="Search"
                        onAction="#onSearchButtonClick"/>

                <Button text="Clear"
                        onAction="#onClearSearchButtonClick"/>

            </HBox>

            <!-- Main inventory table. -->
            <TableView fx:id="inventoryTable"
                       VBox.vgrow="ALWAYS">

                <columns>
                    <TableColumn fx:id="partCodeColumn"
                                 text="Part Code"
                                 prefWidth="100.0"/>

                    <TableColumn fx:id="partNameColumn"
                                 text="Part Name"
                                 prefWidth="210.0"/>

                    <TableColumn fx:id="brandColumn"
                                 text="Brand"
                                 prefWidth="130.0"/>

                    <TableColumn fx:id="priceColumn"
                                 text="Price"
                                 prefWidth="100.0"/>

                    <TableColumn fx:id="quantityColumn"
                                 text="Quantity"
                                 prefWidth="90.0"/>

                    <TableColumn fx:id="categoryColumn"
                                 text="Category"
                                 prefWidth="120.0"/>

                    <TableColumn fx:id="dateAddedColumn"
                                 text="Date Added"
                                 prefWidth="120.0"/>
                </columns>

            </TableView>

            <!-- Buttons used for inventory CRUD operations. -->
            <HBox spacing="10.0">

                <Button text="Add Part"
                        onAction="#onAddPartButtonClick"
                        style="-fx-background-color: #2e7d32;
                               -fx-text-fill: white;"/>

                <Button text="Update Part"
                        onAction="#onUpdatePartButtonClick"
                        style="-fx-background-color: #1565c0;
                               -fx-text-fill: white;"/>

                <Button text="Delete Part"
                        onAction="#onDeletePartButtonClick"
                        style="-fx-background-color: #c62828;
                               -fx-text-fill: white;"/>

                <Button text="Refresh"
                        onAction="#onRefreshButtonClick"/>

            </HBox>

            <!-- Summary information required by the coursework. -->
            <HBox spacing="30.0"
                  style="-fx-background-color: white;
                         -fx-padding: 12px;
                         -fx-border-color: #cfd8dc;">

                <Label text="Total Parts:"/>

                <Label fx:id="totalPartsLabel"
                       text="0"
                       style="-fx-font-weight: bold;"/>

                <Label text="Total Inventory Value:"/>

                <Label fx:id="totalValueLabel"
                       text="Rs. 0.00"
                       style="-fx-font-weight: bold;"/>

            </HBox>

            <!-- Status area used to show feedback to the user. -->
            <Label fx:id="statusLabel"
                   text="Application ready."
                   style="-fx-text-fill: #455a64;"/>

        </VBox>
    </center>

</BorderPane>