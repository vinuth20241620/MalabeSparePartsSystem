<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="lk.vinuth.malabesparepartssystem.controller.DealerController"
      spacing="15.0"
      prefWidth="850.0"
      prefHeight="520.0"
      style="-fx-background-color: #f4f6f8;">

    <padding>
        <Insets top="20.0"
                right="20.0"
                bottom="20.0"
                left="20.0"/>
    </padding>

    <!-- Main heading for the dealer window. -->
    <Label text="Dealer Management"
           style="-fx-font-size: 24px;
                  -fx-font-weight: bold;
                  -fx-text-fill: #263238;"/>

    <!-- Main dealer table. -->
    <TableView fx:id="dealerTable"
               VBox.vgrow="ALWAYS">

        <columns>
            <TableColumn fx:id="dealerIdColumn"
                         text="Dealer ID"
                         prefWidth="100.0"/>

            <TableColumn fx:id="dealerNameColumn"
                         text="Dealer Name"
                         prefWidth="230.0"/>

            <TableColumn fx:id="phoneNumberColumn"
                         text="Phone Number"
                         prefWidth="150.0"/>

            <TableColumn fx:id="emailColumn"
                         text="Email"
                         prefWidth="170.0"/>

            <TableColumn fx:id="addressColumn"
                         text="Location"
                         prefWidth="150.0"/>
        </columns>

    </TableView>

    <!-- Dealer summary and action controls. -->
    <HBox spacing="12.0">

        <Button text="Refresh"
                onAction="#onRefreshButtonClick"/>

        <Label text="Total Dealers:"
               style="-fx-font-weight: bold;"/>

        <Label fx:id="totalDealersLabel"
               text="0"
               style="-fx-font-weight: bold;"/>

    </HBox>

    <!-- Displays status messages. -->
    <Label fx:id="dealerStatusLabel"
           text=""
           wrapText="true"
           style="-fx-text-fill: #455a64;"/>

</VBox>